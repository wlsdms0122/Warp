warpt 1
{
  expect {
    refuses "link"
  }
  name "a-default-outside-its-oneof-refuses-at-link"
  note "A default outside the parameter's own oneOf can never be taken by any call. The declaration is judged at the link, with every other fact a declaration states about itself."
  program {
    needs []
    procedures {
      entry {
        result null
      }
      pick {
        parameters {
          mode {
            default "medium"
            oneOf [
              "fast"
              "slow"
            ]
            type "string"
          }
        }
        result {
          ref "mode"
        }
      }
    }
    warp 1
  }
}
